# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env && chmod 600 .env

# ── Host ──────────────────────────────────────────────
TZ=UTC
PUID=1000
PGID=1000

# ── OpenClaw ──────────────────────────────────────────
# Generate a strong token:  openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Image tag. Use latest-browser if you want the Gateway-controlled browser.
# Pin a dated tag (e.g. 2026.10.5-r20261020) for reproducible deploys.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# Provider keys — set the ones you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Channel tokens.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# 1 = enable agent sandbox (also requires mounting the Docker socket).
OPENCLAW_SANDBOX=0

# Host port, only used if you uncomment the ports block in compose.
OPENCLAW_GATEWAY_PORT=18789

# ── Control UI domain + TLS (NPM proxy host) ──────────
# The public hostname for the OpenClaw Control UI, e.g. openclaw.example.com
# Required by the npm-init service. DNS must point here for Let's Encrypt.
OPENCLAW_DOMAIN=

# true = NPM requests a Let's Encrypt cert, forces HTTPS, enables HSTS.
# false = plain HTTP proxy host (use only behind Tailscale/VPN).
OPENCLAW_TLS_ENABLED=true

# NPM admin credentials used by npm-init to talk to the API.
# Default on a fresh NPM install is admin@example.com / changeme.
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=***

# true = overwrite an existing proxy host for the same domain.
NPM_UPDATE_EXISTING=false

# ── Network topology ──────────────────────────────────
# NPM is pinned to NPM_IP so OpenClaw's gateway.trustedProxies can trust
# exactly that one hop. Change these together if you must.
NPM_SUBNET=172.28.0.0/16
NPM_GATEWAY_IP=172.28.0.1
NPM_IP=172.28.0.10

# ── OpenVPN Access Server ─────────────────────────────
# Password for the default 'openvpn' admin user. Change after first login.
OPENVPN_ADMIN_PASSWORD=
